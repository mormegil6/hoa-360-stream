    - family-names: "Kabaciński"
      given-names: "Marek"
  collection-title: "Proceedings of the AES International Conference on Spatial and Immersive Audio"
  publisher:
    name: "Audio Engineering Society"
  year: 2023
  month: 8
  url: "https://www.aes.org/e-lib/browse.cfm?elib=22204"

