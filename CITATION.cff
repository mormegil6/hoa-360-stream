cff-version: 1.2.0
message: "If you use this software, please cite the paper below (preferred), or the software directly."
title: "Ambisonic Box: containerised Higher-Order Ambisonics + 4K 360 livestream toolchain"
abstract: "A freely-accessible, containerised toolchain for live streaming music events with Higher-Order Ambisonics audio (3rd order, 16 channels, ACN/SN3D) and 4K 360 video over MPEG-DASH, rendered binaurally in the browser."
type: software
authors:
  - family-names: "Mróz"
    given-names: "Bartłomiej"
    orcid: "https://orcid.org/0000-0002-8983-9050"
    email: "bartlomiej.mroz@pg.edu.pl"
    affiliation: "Department of Multimedia Systems, Gdańsk University of Technology"
repository-code: "https://github.com/mormegil6/ambisonic-box"
repository: "https://git.pg.edu.pl/p829296/ambisonic-box"
url: "https://bmroz.eu/projects/360-livestream/"
license: "Apache-2.0"
# Do not edit these two by hand: `./scripts/set-version.sh <version>` sets them together with telemetry/VERSION, which is what a running stack reports on /api/live, and the hygiene workflow fails a push where the two disagree or where a tag does not match them. Without a version a citation describes an unversioned snapshot, which for a toolchain paper is the difference between reproducible and not.
# A -dev marker means the tree has moved past the release named by date-released and has not itself been released.
version: "1.3.5"
date-released: "2026-09-07"
keywords:
  - "Higher-Order Ambisonics"
  - "spatial audio"
  - "360 video"
  - "MPEG-DASH"
  - "live streaming"
  - "binaural rendering"
preferred-citation:
  type: conference-paper
  title: "A Commonly-Accessible Toolchain for Live Streaming Music Events with Higher-Order Ambisonic Audio and 4K 360 Vision"
  authors:
